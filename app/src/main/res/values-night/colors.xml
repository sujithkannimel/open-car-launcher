<?xml version="1.0" encoding="utf-8"?>
<!--
  Night cockpit, "graphite + neon": a neutral graphite base (no blue tint) so the screen is
  calm after dark, with neon cyan as the single accent. The cyan -> violet -> pink gradient
  is drawn in code (knob rings, compass rim, active dock app); see core/Neon.kt.
-->
<resources>
    <color name="cockpit_bg">#FF0C0D0F</color>
    <color name="cockpit_surface">#FF17181B</color>
    <color name="cockpit_surface_alt">#FF222429</color>
    <color name="cockpit_divider">#1FFFFFFF</color>

    <color name="cockpit_text_primary">#FFF3F4F6</color>
    <color name="cockpit_text_secondary">#FFC4C8CE</color>
    <color name="cockpit_text_dim">#FF8B9099</color>

    <color name="cockpit_accent">#FF22D3EE</color>
    <color name="cockpit_accent_dim">#FF8B5CF6</color>
    <color name="cockpit_speed">#FFF3F4F6</color>
    <color name="cockpit_badge">#FFF43F5E</color>

    <color name="cockpit_scrim">#F20C0D0F</color>
    <color name="cockpit_ripple">#338B5CF6</color>

    <color name="cockpit_hud">#E60C0D0F</color>
    <color name="cockpit_ok">#FF4ADE80</color>
    <color name="cockpit_warn">#FFFBBF24</color>
</resources>
