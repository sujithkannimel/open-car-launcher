<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation pill on the music card: tonal fill with a light outline so it reads in sun. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/cockpit_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cockpit_surface_alt" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</ripple>
