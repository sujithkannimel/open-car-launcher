<?xml version="1.0" encoding="utf-8"?>
<!-- Radio seek buttons: quiet tonal circles (the neon accents stay for the knobs and dock). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/cockpit_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/cockpit_surface_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/cockpit_divider" />
        </shape>
    </item>
</ripple>
